{
  "name": "sniper-hunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "artifact": "ENTRY=main vite build && node scripts/artifact.mjs",
    "artifact:arena": "ENTRY=arena vite build && node scripts/artifact.mjs arena",
    "artifact:ski": "ENTRY=ski vite build && node scripts/artifact.mjs ski"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
